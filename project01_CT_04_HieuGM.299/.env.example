# Copy this file to .env for local use; never commit the real .env.
# On Render, add these names in Environment instead.
FPT_API_KEY=
FPT_MODEL=
# Paste the complete Chat Completions URL shown in your FPT model catalog.
FPT_API_URL=
# Alternatively, set a base URL; the application adds /chat/completions.
FPT_BASE_URL=
FPT_MAX_TOKENS=1400
FPT_TIMEOUT_SECONDS=45

# Local Neo4j: see the Docker commands in DEPLOY.md.
# Use an accessible Neo4j/Aura endpoint on Render to enable the live graph backend.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Leave blank to avoid persisting audit files. Audit payload contains metadata only.
AUDIT_LOG_PATH=
