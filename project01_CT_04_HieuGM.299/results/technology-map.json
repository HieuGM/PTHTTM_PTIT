      "agent": "RuleBasedAgent",
      "reads": [
        "question",
        "prediction",
        "glucose",
        "unit"
      ],
      "writes": [
        "rules"
      ],
      "tools": [
        "check"
      ],
      "decision": "allow_retrieval / safety_override"
    },
    {
      "agent": "KGRAGAgent",
      "reads": [
        "question",
        "public corpus",
        "ontology"
      ],
      "writes": [
        "evidence",
        "retrieval"
      ],
      "tools": [
        "AdaptiveRetrieval.run",
        "KnowledgeBase.retrieve"
      ],
      "decision": "accept / rewrite / lexical retry / abstain"
    },
    {
      "agent": "CoordinatorAgent",
      "reads": [
        "request",
        "intermediate outputs"
      ],
      "writes": [
        "request_id",
        "status",
        "messages",
        "report"
      ],
      "tools": [
        "ReportWorkflow.run"
      ],
      "decision": "schedule / aggregate / terminate"
    },
    {
      "agent": "ExplanationAgent",
      "reads": [
        "question",
        "prediction",
        "rules",
        "evidence"
      ],
      "writes": [
        "explanation",
        "quality"
      ],
      "tools": [
        "EvidenceGenerator.generate",
        "review_and_revise"
      ],
      "decision": "pass / extractive revision / abstain / safety_rule"
    },
    {
      "agent": "MonitoringAgent",
      "reads": [
        "execution metadata"
      ],
      "writes": [
        "audit"
      ],
      "tools": [
        "MonitoringAgent.run"
      ],
      "decision": "metadata_only / opt-in write / degraded"
    }
